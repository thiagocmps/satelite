# =============================================================================
# satelite - variaveis de ambiente
# Copie para .env:  cp .env.example .env
#
# O arquivo .env NAO entra no container: ele e usado pelo Docker Compose para
# interpolar valores. As variaveis que o backend precisa sao passadas
# explicitamente no bloco `environment:` do servico `backend` (docker-compose.yml).
# =============================================================================

# --- Docker Compose ---------------------------------------------------------
FRONTEND_PORT=4100
BACKEND_PORT=4000
POSTGRES_PORT=5433
POSTGRES_USER=satelite
POSTGRES_PASSWORD=satelite
POSTGRES_DB=satelite

# --- Aplicacao --------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Origens autorizadas no CORS. Vazio = nenhuma (mesma origem, via proxy nginx).
CORS_ORIGINS=

# --- Limitacao de requisicao ------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
SUMMARY_RATE_LIMIT_WINDOW_MS=60000
SUMMARY_RATE_LIMIT_MAX=10

# --- Ingestao ---------------------------------------------------------------
# ENABLE_INGEST=false desliga o agendador (util para rodar apenas sob demanda).
ENABLE_INGEST=true
INGEST_CRON=*/15 * * * *
INGEST_CONCURRENCY=4
INGEST_TIMEOUT_MS=20000
FEED_MAX_BYTES=8000000

# --- IA (OpenRouter) --------------------------------------------------------
# AI_PROVIDER define qual provedor registrado em src/integrations/ai/ai.registry.ts
# sera usado. Trocar de provedor = novo arquivo + 1 linha no registry.
AI_PROVIDER=openrouter
# Crie a chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# "openrouter/free" roteia para um modelo gratuito disponivel no momento.
AI_MODEL=openrouter/free
# Tentados quando o modelo principal falha (429/5xx/timeout).
AI_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=v1
AI_LANGUAGE=pt-BR
AI_MAX_CONTENT_CHARS=4000

# --- Classificacao hibrida por IA -------------------------------------------
# A IA (OpenRouter) so entra quando a keyword nao decide (ambigua ou ausente).
# Fila "needs_ai": quando marcar, rode POST /api/v1/ingest/classify (ou o botao
# "Classificar pendentes" em Fontes). O backfill inicial cobre 30 dias.
AI_CLASSIFY_ENABLED=true
# Vazio = reusa AI_MODEL para classificar tambem.
AI_CLASSIFY_MODEL=
# Tentados quando o modelo de classificacao falha (lista de fallbacks).
AI_CLASSIFY_FALLBACK_MODELS=
AI_CLASSIFY_TIMEOUT_MS=45000
AI_CLASSIFY_MAX_RETRIES=2
AI_CLASSIFY_BATCH=25
AI_CLASSIFY_CONCURRENCY=2
# Abaixo deste piso a categoria da IA e descartada (confianca fica gravada).
AI_CLASSIFY_MIN_CONFIDENCE=0.5
# Texto minimo (titulo+descricao+conteudo) para a IA entrar na duvida.
AI_CLASSIFY_MIN_TEXT_CHARS=120
